rules_version = '2';

// Estas reglas son la seguridad REAL del sistema — no la URL, no el código.
// Pégalas en Firebase Console → Firestore Database → Reglas.
//
// Jerarquía de roles:
// - master: SOLO Roxy. Control total. Su cuenta nunca se puede borrar desde la app.
// - admin: control total igual que master (ej. Dirección Académica, Registro y
//   Control), pero SÍ se puede quitar desde el panel de Accesos.
// - coordinador / secretaria: gestionan profesores, clases y estudiantes de su sede.
// - profesor: solo sus propias clases.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function miCorreo() {
      return request.auth.token.email.lower();
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(miCorreo())).data;
    }

    function miRol() {
      return miPerfil().rol;
    }

    function esMaster() {
      return estaLogueado() && miRol() == 'master';
    }

    function esAdminOMaster() {
      return estaLogueado() && miRol() in ['master', 'admin'];
    }

    function esGestor() {
      // Puede crear/editar profesores, clases y estudiantes.
      return estaLogueado() && miRol() in ['master', 'admin', 'coordinador', 'secretaria'];
    }

    // Bloqueo de períodos cerrados: una vez un período queda "inactivo" en
    // /periodos, nadie (excepto Master) puede seguir editando clases, notas
    // o asistencia que pertenezcan a ese año-periodo-ciclo. Si el período no
    // tiene documento (nunca se creó), se trata como activo por defecto.
    function periodoIdDeDatos(datos) {
      return string(datos.anio) + '-' + string(datos.periodo) + '-' + string(datos.ciclo);
    }
    function periodoEstaActivo(datos) {
      let ref = /databases/$(database)/documents/periodos/$(periodoIdDeDatos(datos));
      return !exists(ref) || get(ref).data.activo != false;
    }

    // Colección "usuarios": doc ID = correo en minúsculas.
    // - Leer: cada quien su propio perfil, o cualquier admin/master ve todos.
    // - Crear/editar: admin o master, pero SOLO master puede asignar el rol "master".
    // - Borrar: admin o master, pero NUNCA se puede borrar una cuenta con rol "master".
    match /usuarios/{correoId} {
      function tieneMiSede(datos) {
        return (datos.ciudadId == miPerfil().ciudadId) ||
               (datos.ciudadIds != null && miPerfil().ciudadId in datos.ciudadIds);
      }

      allow read: if estaLogueado() && (
        miCorreo() == correoId ||
        esAdminOMaster() ||
        (miRol() in ['coordinador', 'secretaria'] && tieneMiSede(resource.data))
      );

      allow create, update: if estaLogueado() && (
        (esAdminOMaster() && (request.resource.data.rol != 'master' || esMaster())) ||
        (miRol() in ['coordinador', 'secretaria'] &&
         request.resource.data.rol in ['coordinador', 'secretaria', 'profesor'] &&
         tieneMiSede(request.resource.data))
      );

      allow delete: if estaLogueado() && (
        (esAdminOMaster() && resource.data.rol != 'master') ||
        (miRol() in ['coordinador', 'secretaria'] &&
         resource.data.rol in ['coordinador', 'secretaria', 'profesor'] &&
         tieneMiSede(resource.data))
      );
    }

    // Colección "ciudades": sedes con su correo de coordinación y URL de alertas.
    match /ciudades/{id} {
      allow read: if estaLogueado();
      allow write: if esAdminOMaster();
    }

    // Colección "periodos": doc ID = "{anio}-{periodo}-{ciclo}", ej. "2026-1-3".
    // Guarda fecha de inicio/fin y si está activo. Coordinadores y secretarias
    // también pueden activar/desactivar (esGestor), no solo admin/master.
    match /periodos/{id} {
      allow read: if estaLogueado();
      allow write: if esGestor();
    }

    // Colección "clases": nivel + grupo + docente + horario + ciudad + programa + periodo
    match /clases/{claseId} {
      allow read: if estaLogueado();
      allow create: if esGestor();
      // Editar/borrar una clase: bloqueado si su período ya está cerrado
      // (salvo Master, que siempre puede corregir cualquier cosa).
      allow update, delete: if esGestor() && (esMaster() || periodoEstaActivo(resource.data));

      match /sesiones/{fecha} {
        allow read: if estaLogueado();
        allow write: if estaLogueado() && (
          esMaster() ||
          (
            (
              esAdminOMaster() ||
              (miRol() in ['coordinador', 'secretaria'] && get(/databases/$(database)/documents/clases/$(claseId)).data.ciudadId == miPerfil().ciudadId) ||
              (miRol() == 'profesor' && get(/databases/$(database)/documents/clases/$(claseId)).data.docenteCorreo == miCorreo())
            ) && periodoEstaActivo(get(/databases/$(database)/documents/clases/$(claseId)).data)
          )
        );
      }
    }

    // Colección "estudiantes": nombre, apellido, cédula, correo, clase asignada
    // Compartimentado por rol: profesor solo ve estudiantes de SUS clases;
    // coordinador/secretaria solo ven estudiantes de SU sede asignada;
    // admin/master ven todo.
    match /estudiantes/{id} {
      allow read: if estaLogueado() && (
        esAdminOMaster() ||
        (miRol() in ['coordinador', 'secretaria'] && resource.data.ciudadId == miPerfil().ciudadId) ||
        (miRol() == 'profesor' && get(/databases/$(database)/documents/clases/$(resource.data.claseId)).data.docenteCorreo == miCorreo())
      );
      allow write: if esGestor();
    }

    // Colección "logs": historial de auditoría, inmutable. Solo admin/master lo leen.
    match /logs/{id} {
      allow read: if esMaster();
      allow create: if estaLogueado();
      allow update, delete: if false;
    }

    // Colección "programas": cada uno define sus cortes, pesos y notas,
    // anclado a un año/periodo/ciclo específico.
    match /programas/{id} {
      allow read: if estaLogueado();
      allow write: if esAdminOMaster();
    }

    // Colección "avisos_habilitacion": registro de a quién se le notificó
    // que debe habilitar (2.5-2.9). Es la base de datos que usará el
    // futuro script de envío de correos.
    match /avisos_habilitacion/{id} {
      allow read: if esGestor();
      allow write: if esGestor();
    }

    match /avisos_perdida/{id} {
      allow read: if esGestor();
      allow write: if esGestor();
    }

    // Colección "avisos_inasistencia": registro de a quién se le alertó
    // por exceder el umbral de horas ausentes en un ciclo.
    match /avisos_inasistencia/{id} {
      allow read: if esGestor();
      allow write: if esGestor();
    }

    match /avisos_perdida_inasistencia/{id} {
      allow read: if esGestor();
      allow write: if esGestor();
    }

    // Colección "plantillas_correo": el texto de cada tipo de aviso
    // (alerta_habilitacion, perdida_habilitacion, alerta_inasistencia,
    // perdida_inasistencia), con marcadores {nombre}, {nivel}, {grupo}.
    match /plantillas_correo/{id} {
      allow read: if esGestor();
      allow write: if esGestor();
    }

    // Colección "configuracion": legado, ya no se usa activamente.
    match /configuracion/{id} {
      allow read: if estaLogueado();
      allow write: if esAdminOMaster();
    }

    // Colección "notas": el ID del documento es "{claseId}_{cedula}", así
    // podemos saber de qué clase es sin depender de que el documento ya
    // exista (leer un documento inexistente rompía la validación anterior).
    match /notas/{id} {
      function claseIdDelDocumento() {
        return id.split('_')[0];
      }
      function claseReferenciada() {
        return get(/databases/$(database)/documents/clases/$(claseIdDelDocumento())).data;
      }
      function esMiPropiaClase() {
        return miRol() == 'profesor' && claseReferenciada().docenteCorreo == miCorreo();
      }
      function esMiSedeComoCoordinacion() {
        return miRol() in ['coordinador', 'secretaria'] && claseReferenciada().ciudadId == miPerfil().ciudadId;
      }

      // Leer: admin/master (todo), coordinación (solo su sede), profesor (solo sus clases).
      allow read: if estaLogueado() && (esAdminOMaster() || esMiSedeComoCoordinacion() || esMiPropiaClase());
      // Escribir: SOLO admin/master o el profesor dueño de la clase, Y SOLO
      // si el período de esa clase sigue activo (Master siempre puede, sin excepción).
      allow create, update: if estaLogueado() && (
        esMaster() ||
        ((esAdminOMaster() || esMiPropiaClase()) && periodoEstaActivo(claseReferenciada()))
      );
      allow delete: if esAdminOMaster();

      // Historial: guarda versiones anteriores antes de cada sobrescritura.
      // Mismo criterio de lectura que la nota; nunca se edita ni se borra.
      match /historial/{historialId} {
        allow read: if estaLogueado() && (esAdminOMaster() || esMiSedeComoCoordinacion() || esMiPropiaClase());
        allow create: if estaLogueado() && (esMaster() || esAdminOMaster() || esMiPropiaClase());
        allow update, delete: if false;
      }
    }
  }
}
