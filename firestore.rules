rules_version = '2';

// Estas reglas son la seguridad REAL del sistema — no la URL, no el código.
// Pégalas en Firebase Console → Firestore Database → Reglas.
//
// Jerarquía de roles:
// - master: SOLO Roxy. Control total. Su cuenta nunca se puede borrar desde la app.
// - admin: control total igual que master (ej. Dirección Académica, Registro y
//   Control), pero SÍ se puede quitar desde el panel de Accesos.
// - coordinador / secretaria: gestionan profesores, clases y estudiantes de su sede.
// - profesor: solo sus propias clases.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function miCorreo() {
      return request.auth.token.email.lower();
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(miCorreo())).data;
    }

    function miRol() {
      return miPerfil().rol;
    }

    function esMaster() {
      return estaLogueado() && miRol() == 'master';
    }

    function esAdminOMaster() {
      return estaLogueado() && miRol() in ['master', 'admin'];
    }

    function esGestor() {
      // Puede crear/editar profesores, clases y estudiantes.
      return estaLogueado() && miRol() in ['master', 'admin', 'coordinador', 'secretaria'];
    }

    // Colección "usuarios": doc ID = correo en minúsculas.
    // - Leer: cada quien su propio perfil, o cualquier admin/master ve todos.
    // - Crear/editar: admin o master, pero SOLO master puede asignar el rol "master".
    // - Borrar: admin o master, pero NUNCA se puede borrar una cuenta con rol "master".
    match /usuarios/{correoId} {
      allow read: if estaLogueado() && (miCorreo() == correoId || esAdminOMaster());
      allow create, update: if esAdminOMaster() &&
        (request.resource.data.rol != 'master' || esMaster());
      allow delete: if esAdminOMaster() && resource.data.rol != 'master';
    }

    // Colección "ciudades": sedes con su correo de coordinación y URL de alertas.
    match /ciudades/{id} {
      allow read: if estaLogueado();
      allow write: if esAdminOMaster();
    }

    // Colección "periodos": doc ID = "{anio}-{periodo}-{ciclo}", ej. "2026-1-3".
    // Guarda fecha de inicio/fin y si está activo. Coordinadores y secretarias
    // también pueden activar/desactivar (esGestor), no solo admin/master.
    match /periodos/{id} {
      allow read: if estaLogueado();
      allow write: if esGestor();
    }

    // Colección "clases": nivel + grupo + docente + horario + ciudad + programa + periodo
    match /clases/{claseId} {
      allow read: if estaLogueado();
      allow write: if esGestor();

      match /sesiones/{fecha} {
        allow read: if estaLogueado();
        allow write: if estaLogueado() && (
          esGestor() ||
          (miRol() == 'profesor' && get(/databases/$(database)/documents/clases/$(claseId)).data.docenteCorreo == miCorreo())
        );
      }
    }

    // Colección "estudiantes": nombre, apellido, cédula, correo, clase asignada
    // Compartimentado por rol: profesor solo ve estudiantes de SUS clases;
    // coordinador/secretaria solo ven estudiantes de SU sede asignada;
    // admin/master ven todo.
    match /estudiantes/{id} {
      allow read: if estaLogueado() && (
        esAdminOMaster() ||
        (miRol() in ['coordinador', 'secretaria'] && resource.data.ciudadId == miPerfil().ciudadId) ||
        (miRol() == 'profesor' && get(/databases/$(database)/documents/clases/$(resource.data.claseId)).data.docenteCorreo == miCorreo())
      );
      allow write: if esGestor();
    }

    // Colección "logs": historial de auditoría, inmutable. Solo admin/master lo leen.
    match /logs/{id} {
      allow read: if esMaster();
      allow create: if estaLogueado();
      allow update, delete: if false;
    }

    // Colección "programas": cada uno define sus cortes, pesos y notas,
    // anclado a un año/periodo/ciclo específico.
    match /programas/{id} {
      allow read: if estaLogueado();
      allow write: if esAdminOMaster();
    }

    // Colección "configuracion": legado, ya no se usa activamente.
    match /configuracion/{id} {
      allow read: if estaLogueado();
      allow write: if esAdminOMaster();
    }

    // Colección "notas": el ID del documento es "{claseId}_{cedula}", así
    // podemos saber de qué clase es sin depender de que el documento ya
    // exista (leer un documento inexistente rompía la validación anterior).
    match /notas/{id} {
      function claseIdDelDocumento() {
        return id.split('_')[0];
      }
      function esMiPropiaClase() {
        return miRol() == 'profesor' &&
          get(/databases/$(database)/documents/clases/$(claseIdDelDocumento())).data.docenteCorreo == miCorreo();
      }

      allow read: if estaLogueado() && (esGestor() || esMiPropiaClase());
      allow create, update: if estaLogueado() && (esGestor() || esMiPropiaClase());
      allow delete: if esGestor();
    }
  }
}
